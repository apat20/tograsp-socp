<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile that disables the shared-memory transport and uses UDP only.

  Use it when topics are visible across containers (ros2 topic list works) but
  no messages arrive, which usually means the containers cannot share memory
  segments (different IPC namespace or different user IDs).

  Enable it by setting, in every container that should use it:
    FASTRTPS_DEFAULT_PROFILES_FILE=/app/docker/fastdds_udp_only.xml

  UDP is slower than shared memory for large point clouds, but for a single
  cloud per request the difference is small.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_only</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_only_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_only</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
